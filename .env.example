# Copy to .env and adjust if needed (do not commit .env)

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sentence_builder
DB_USER=sentence
DB_PASS=sentence
DB_PREFER_JDBC=true

# Or AWS RDS (Ahmed) — if DATABASE_URL is set, it wins over DB_HOST/DB_NAME
# DATABASE_URL=jdbc:mysql://your-rds-host:3306/sentence_builder?useSSL=true&serverTimezone=UTC
# DATABASE_USERNAME=admin
# DATABASE_PASSWORD=secret

