<?xml version="1.0" encoding="UTF-8"?>

<!--
  Word editor: filterable / sortable word table with edit form.
  Author: Ved Mahant
  Date: 2026-10-16
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utdallas.cs4485.team22.sentencebuilder.ui.WordEditorController"
      styleClass="screen" spacing="14">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <Label text="Word Editor" styleClass="screen-title"/>
    <Label text="Browse the corpus, filter by text, sort by word or frequency, and edit selected word metadata."
           styleClass="screen-subtitle" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="filterField" promptText="Filter words…" HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="wordTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colWord" text="Word" prefWidth="220"/>
            <TableColumn fx:id="colFrequency" text="Frequency" prefWidth="110"/>
            <TableColumn fx:id="colStart" text="Sentence start" prefWidth="120"/>
            <TableColumn fx:id="colEnd" text="Sentence end" prefWidth="120"/>
        </columns>
    </TableView>

    <Label text="Edit selected word" styleClass="field-label"/>
    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Text" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="editTextField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Frequency" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="editFreqField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <CheckBox fx:id="editStartCheck" text="Used as sentence start"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <CheckBox fx:id="editEndCheck" text="Used as sentence end"
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Save changes" styleClass="primary-button" onAction="#onSave"/>
    </HBox>
    <Label fx:id="messageLabel" text="" styleClass="hint-label"/>
</VBox>
