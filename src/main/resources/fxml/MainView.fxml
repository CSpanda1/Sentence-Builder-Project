<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="edu.utdallas.cs4485.team22.sentencebuilder.ui.MainController" styleClass="root-pane">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="workspace-bar">
            <Label text="SENTENCE BUILDER" styleClass="toolbar-brand" wrapText="true" />
            <Label text="/" styleClass="toolbar-divider" wrapText="true" />
            <Label text="Overview" styleClass="toolbar-caption" wrapText="true" fx:id="pageTitle" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="modeBadge" text="WORKSPACE" styleClass="mode-badge" />
            <Button text="How to use" onAction="#showHelp" styleClass="help-button" />
        </HBox>
    </top>
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="232" spacing="9">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12" />
            </padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fitWidth="52" fitHeight="52" preserveRatio="true" accessibleText="UT Dallas logo">
                    <image>
                        <Image url="@../images/utd-logo.png" />
                    </image>
                </ImageView>
                <VBox spacing="12" styleClass="brand-lockup">
                    <Label text="UT DALLAS" styleClass="brand-kicker" wrapText="true" />
                    <Label text="Language Lab" styleClass="brand-title" wrapText="true" />
                </VBox>
            </HBox>
            <Label text="WORKSPACE" styleClass="sidebar-section" wrapText="true" />
            <Separator />
            <Button text="Overview" styleClass="nav-button" maxWidth="Infinity" onAction="#showHome" fx:id="navHome">
                <graphic>
                    <Label text="⌂" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Overview" />
                </tooltip>
            </Button>
            <Button fx:id="navImport" text="Import corpus" styleClass="nav-button" maxWidth="Infinity" onAction="#showImport">
                <graphic>
                    <Label text="↥" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Import corpus" />
                </tooltip>
            </Button>
            <Button fx:id="navGenerate" text="Generate" styleClass="nav-button" maxWidth="Infinity" onAction="#showGenerate">
                <graphic>
                    <Label text="✦" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Generate" />
                </tooltip>
            </Button>
            <Button fx:id="navAutocomplete" text="Compose" styleClass="nav-button" maxWidth="Infinity" onAction="#showAutocomplete">
                <graphic>
                    <Label text="✎" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Compose" />
                </tooltip>
            </Button>
            <Button fx:id="navWords" text="Word library" styleClass="nav-button" maxWidth="Infinity" onAction="#showWords">
                <graphic>
                    <Label text="≡" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Word library" />
                </tooltip>
            </Button>
            <Button fx:id="navReports" text="Reports" styleClass="nav-button" maxWidth="Infinity" onAction="#showReports">
                <graphic>
                    <Label text="▥" styleClass="nav-icon" wrapText="true" />
                </graphic>
                <tooltip>
                    <Tooltip text="Open Reports" />
                </tooltip>
            </Button>
            <VBox VBox.vgrow="ALWAYS" />
            <VBox spacing="12" styleClass="sidebar-note">
                <Label text="Built for curious minds." styleClass="sidebar-note-title" wrapText="true" />
                <Label text="Explore how language becomes patterns, one word at a time." styleClass="sidebar-note-copy" wrapText="true" />
            </VBox>
            <Label text="CS 4485 / SENIOR DESIGN" styleClass="brand-subtitle" />
            <Label text="Ctrl+0 Overview  ·  Ctrl+1–5 tools" styleClass="hint-label" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane" />
    </center>
    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16" />
            </padding>
            <Label fx:id="statusWords" text="Words: 0" styleClass="status-label" />
            <Label fx:id="statusUnique" text="Unique: 0" styleClass="status-label" />
            <Label fx:id="statusLastImport" text="Last import: —" styleClass="status-label" />
        </HBox>
    </bottom>
</BorderPane>