<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utdallas.cs4485.team22.sentencebuilder.ui.ReportsController" styleClass="screen" spacing="20">
    <padding>
        <Insets top="24" right="28" bottom="28" left="28" />
    </padding>
    <HBox spacing="22" alignment="CENTER_LEFT" styleClass="hero-card">
        <VBox spacing="12" styleClass="tool-header-copy" HBox.hgrow="ALWAYS">
            <Label text="05 / CORPUS INSIGHTS" styleClass="hero-kicker" wrapText="true" />
            <Label text="Your language, at a glance." styleClass="hero-title" wrapText="true" />
            <Label text="Track your sources, explore generated sentences, and understand the corpus behind every result." styleClass="hero-subtitle" wrapText="true" />
        </VBox>
        <ImageView fitWidth="64" fitHeight="64" preserveRatio="true" accessibleText="UT Dallas logo">
            <image>
                <Image url="@../images/utd-logo.png" />
            </image>
        </ImageView>
    </HBox>
    <HBox spacing="14">
        <VBox spacing="12" styleClass="metric-card" HBox.hgrow="ALWAYS" prefWidth="210">
            <Label text="TOTAL WORDS" styleClass="metric-label" wrapText="true" />
            <Label fx:id="statsTotal" text="0" styleClass="metric-value" />
            <Label text="Tokens in your corpus" styleClass="metric-hint" wrapText="true" />
        </VBox>
        <VBox spacing="12" styleClass="metric-card" HBox.hgrow="ALWAYS" prefWidth="210">
            <Label text="VOCABULARY" styleClass="metric-label" wrapText="true" />
            <Label fx:id="statsUnique" text="0" styleClass="metric-value" />
            <Label text="Distinct words learned" styleClass="metric-hint" wrapText="true" />
        </VBox>
        <VBox spacing="12" styleClass="metric-card" HBox.hgrow="ALWAYS" prefWidth="210">
            <Label text="IMPORTED FILES" styleClass="metric-label" wrapText="true" />
            <Label fx:id="statsFiles" text="0" styleClass="metric-value" />
            <Label text="Your text sources" styleClass="metric-hint" wrapText="true" />
        </VBox>
        <VBox spacing="12" styleClass="metric-card" HBox.hgrow="ALWAYS" prefWidth="210">
            <Label text="GENERATED SENTENCES" styleClass="metric-label" wrapText="true" />
            <Label fx:id="statsSentences" text="0" styleClass="metric-value" />
            <Label text="Saved in sentence history" styleClass="metric-hint" wrapText="true" />
        </VBox>
    </HBox>
    <VBox spacing="12" styleClass="surface-card" VBox.vgrow="ALWAYS">
        <Label text="Explore your workspace" styleClass="section-title" wrapText="true" />
        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" minHeight="260">
            <Tab text="Imported files">
                <VBox spacing="8" styleClass="tab-content">
                    <padding>
                        <Insets top="12" right="4" bottom="4" left="4" />
                    </padding>
                    <TableView fx:id="filesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFileName" text="File" prefWidth="200" />
                            <TableColumn fx:id="colFilePath" text="Path" prefWidth="280" />
                            <TableColumn fx:id="colFileWords" text="Words" prefWidth="80" />
                            <TableColumn fx:id="colFileUnique" text="Unique" prefWidth="80" />
                            <TableColumn fx:id="colFileWhen" text="Imported at" prefWidth="160" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Sentence history">
                <VBox spacing="8" styleClass="tab-content">
                    <padding>
                        <Insets top="12" right="4" bottom="4" left="4" />
                    </padding>
                    <Label text="Duplicate sentences are marked so batch generation can be audited." styleClass="hint-label" wrapText="true" />
                    <TableView fx:id="sentencesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSentText" text="Sentence" prefWidth="420" />
                            <TableColumn fx:id="colSentAlgo" text="Algorithm" prefWidth="160" />
                            <TableColumn fx:id="colSentStart" text="Start word" prefWidth="100" />
                            <TableColumn fx:id="colSentDup" text="Duplicate" prefWidth="90" />
                            <TableColumn fx:id="colSentWhen" text="Created" prefWidth="160" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Corpus stats">
                <VBox spacing="12" styleClass="tab-content">
                    <padding>
                        <Insets top="16" right="8" bottom="8" left="8" />
                    </padding>
                    <Label fx:id="statsDuplicates" text="Duplicate sentences: 0" styleClass="stat-line" />
                    <Label fx:id="statsLastImport" text="Last import: —" styleClass="stat-line" />
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</VBox>